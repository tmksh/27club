# Supabase設定
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Instagram API連携（オプション）
# Facebook Developer (https://developers.facebook.com/) でアプリを作成し、
# Instagram Basic Display API のアクセストークンを取得してください
# 
# 設定手順:
# 1. Facebook Developer でアプリを作成
# 2. 「Instagram Basic Display」を追加
# 3. テストユーザーを追加してアクセストークンを生成
# 4. 長期アクセストークンに変換（60日有効）
#
# 参考: https://developers.facebook.com/docs/instagram-basic-display-api/getting-started
VITE_INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
VITE_INSTAGRAM_USER_ID=me
